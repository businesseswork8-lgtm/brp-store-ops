# =====================================================================
# BRP Store Operations - Environment Configuration Template
# Copy this file to .env.local and populate with your project's credentials.
# NEVER commit .env.local or expose service-role keys to client code!
# =====================================================================

# Public Supabase credentials (Client-safe, protected via Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Server-only Supabase Service Role Key (CONFIDENTIAL - DO NOT PREFIX WITH NEXT_PUBLIC)
# Required for server-side administrative tasks (user provisioning, secure password overrides).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Optional: Application URL for CORS and password reset redirection
# NEXT_PUBLIC_APP_URL=https://brp-store-ops.vercel.app
